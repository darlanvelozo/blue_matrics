# ============================================================
# BlueMetrics — variáveis de ambiente (modelo)
# Copie para .env e preencha. NÃO commitar .env.
# ============================================================

# --- Django ---------------------------------------------------
DJANGO_SETTINGS_MODULE=bluemetrics.settings.dev
SECRET_KEY=change-me-use-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------
POSTGRES_DB=bluemetrics
POSTGRES_USER=bluemetrics
POSTGRES_PASSWORD=bluemetrics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://bluemetrics:bluemetrics@postgres:5432/bluemetrics

# --- Redis ----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Crypto ---------------------------------------------------
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Conta Azul (OAuth2) -------------------------------------
# Cadastrar app em https://portaldevs.contaazul.com/
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_REDIRECT_URI=http://localhost:8000/api/integrations/contaazul/callback
CONTA_AZUL_AUTH_URL=https://auth.contaazul.com/oauth2/authorize
CONTA_AZUL_TOKEN_URL=https://auth.contaazul.com/oauth2/token
CONTA_AZUL_API_BASE=https://api-v2.contaazul.com/v1

# --- Stripe ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (insights IA) ---------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- E-mail (Resend) -----------------------------------------
RESEND_API_KEY=
EMAIL_FROM=BlueMetrics <no-reply@bluemetrics.app>

# --- Observabilidade -----------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# --- CORS / Frontend -----------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) --------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
